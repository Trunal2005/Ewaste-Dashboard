# ==========================================
# EWEM Workspace Environment Configuration
# ==========================================

# Port for the Node/Express backend (Render/Railway automatically assign PORT)
PORT=3001

# Node environment
NODE_ENV=production

# Storage paths (Use persistent volume mounts in production, e.g. /data/ewaste.sqlite)
# If omitted, defaults to local ./data/ewaste.sqlite and ./uploads
DB_PATH=
UPLOADS_DIR=

# Owner Passcode for unlocking Edit & Upload mode in the dashboard (Read-Only presentation by default)
ADMIN_KEY=trunal_ewem_owner_passcode

# Optional: Remote API URL for frontend if client and backend are hosted on separate domains
# Leave blank when deploying unified (frontend served from backend)
VITE_API_URL=
